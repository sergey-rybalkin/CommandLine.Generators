<Project>
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <Using Include="Shouldly" />
    <Using Include="NSubstitute" />
  </ItemGroup>

  <!-- Assembly Attributes -->
  <PropertyGroup>
    <Product>CommandLine.Generators Tests</Product>
    <Company>Sergey Rybalkin</Company>
    <Version Condition="'$(GitVersion)' != ''">$(GitVersion)</Version>

    <!-- Each assembly has its own title that is specified in AssemblyInfo.cs -->
    <GenerateAssemblyTitleAttribute>False</GenerateAssemblyTitleAttribute>
  </PropertyGroup>

  <!-- Common project settings -->
  <PropertyGroup>
    <!-- See https://github.com/dotnet/project-system/blob/main/docs/build-acceleration.md -->
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildDate</_Parameter1>
      <_Parameter2>$([System.DateTime]::UtcNow.ToString("s"))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <PropertyGroup>
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\..\..\build\vs.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <!-- Include personal MSBuild settings that are ignored by source control -->
  <Import Condition="Exists('$(MSBuildThisFileDirectory)\Directory.Personal.props')" Project="$(MSBuildThisFileDirectory)\Directory.Personal.props" />

</Project>